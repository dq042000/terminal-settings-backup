[general]
compat-delete='delete-sequence'
display-n=0
display-tab-names=0
fullscreen-hide-tabbar=false
gtk-use-system-default-theme=false
hide-tabs-if-one-tab=false
history-size=1000
load-guake-yml=true
max-tab-name-length=100
mouse-display=true
open-tab-cwd=true
prompt-on-quit=true
quick-open-command-line='gedit %(file_path)s'
restore-tabs-notify=true
restore-tabs-startup=true
save-tabs-when-changed=true
scroll-keystroke=true
set-window-title=true
start-at-login=true
start-fullscreen=true
use-default-font=false
use-popup=true
use-scrollbar=true
use-trayicon=true
use-vte-titles=false
window-halignment=1
window-height=33
window-losefocus=false
window-refocus=true
window-tabbar=true
window-width=100

[keybindings/global]
show-hide='F10'

[keybindings/local]
toggle-fullscreen='disabled'

[style/background]
transparency=92

[style/font]
allow-bold=true
bold-is-bright=true
palette='#000000000000:#cdcd31313131:#0d0dbcbc7979:#e5e5e5e51010:#24247272c8c8:#bcbc3f3fbcbc:#1111a8a8cdcd:#e5e5e5e5e5e5:#666666666666:#f1f14c4c4c4c:#2323d1d18b8b:#f5f5f5f54343:#3b3b8e8eeaea:#d6d67070d6d6:#2929b8b8dbdb:#e5e5e5e5e5e5:#cccccccccccc:#1e1e1e1e1e1e'
palette-name='Custom'
style='MesloLGLDZ Nerd Font 12'
